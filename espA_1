#include <WiFi.h>
#include <ESPAsyncWebServer.h>
#include "esp_adc_cal.h"
#include "driver/adc.h"

const char* SSID = "ESP-Connect";
const char* PASS = "12345678";

#define ADC_CHANNEL      ADC1_CHANNEL_6   // GPIO34
#define ADC_WIDTH        ADC_WIDTH_BIT_12
#define ADC_ATTEN        ADC_ATTEN_DB_11
#define VREF_MV          1100
#define SAMPLES          64
#define LED_PIN          2
#define DAC_PIN          25               // GPIO25 -> B’s ADC

AsyncWebServer server(80);
AsyncWebSocket ws("/ws");
esp_adc_cal_characteristics_t adc_chars;

float offsetV = 0.0f;
float latestV  = 0.0f;

static float readVoltage() {
  uint32_t acc = 0;
  for (int i = 0; i < SAMPLES; ++i) acc += adc1_get_raw(ADC_CHANNEL);
  acc /= SAMPLES;
  uint32_t mv = esp_adc_cal_raw_to_voltage(acc, &adc_chars);
  return mv / 1000.0f;
}

void onWsEvent(AsyncWebSocket* server, AsyncWebSocketClient* client,
               AwsEventType type, void* arg, uint8_t* data, size_t len) {
  if (type != WS_EVT_DATA) return;
  String msg((char*)data, len);
  // Forward any {"received":...} from B directly to all (incl. app)
  if (msg.indexOf("\"received\"") != -1) {
    ws.textAll(msg);
    return;
  }
  // Store offset from app
  if (msg.indexOf("\"offset\"") != -1) {
    int i = msg.indexOf(':'); if (i >= 0) offsetV = msg.substring(i+1).toFloat();
    return;
  }
  // Apply: output (raw + offset) to DAC, tell everyone what we applied
  if (msg.indexOf("\"apply\"") != -1) {
    float applied = constrain(latestV + offsetV, 0.0f, 3.3f);
    int dacVal = (int)(applied / 3.3f * 255.0f);
    dacVal = constrain(dacVal, 0, 255);
    dacWrite(DAC_PIN, dacVal);
    ws.textAll(String("{\"applied\":") + String(applied, 2) + "}");
    digitalWrite(LED_PIN, HIGH); delay(30); digitalWrite(LED_PIN, LOW);
    return;
  }
}

void setup() {
  pinMode(LED_PIN, OUTPUT);
  Serial.begin(115200);

  adc1_config_width(ADC_WIDTH);
  adc1_config_channel_atten(ADC_CHANNEL, ADC_ATTEN);
  esp_adc_cal_characterize(ADC_UNIT_1, ADC_ATTEN, ADC_WIDTH, VREF_MV, &adc_chars);

  WiFi.softAP(SSID, PASS);
  Serial.print("AP IP: "); Serial.println(WiFi.softAPIP());

  ws.onEvent(onWsEvent);
  server.addHandler(&ws);
  server.begin();
}

void loop() {
  static uint32_t t = 0, tClean = 0;
  if (millis() - t >= 200) {
    latestV = readVoltage();
    ws.textAll(String("{\"raw\":") + String(latestV, 2) + "}");
    t = millis();
  }
  // keep clients tidy
  if (millis() - tClean >= 2000) { ws.cleanupClients(); tClean = millis(); }
}

#include <WiFi.h>
#include <WebSocketsClient.h>
#include "esp_adc_cal.h"
#include "driver/adc.h"

const char* SSID = "ESP-Connect";
const char* PASS = "12345678";
const char* WS_HOST = "192.168.4.1";
const uint16_t WS_PORT = 80;
const char* WS_PATH = "/ws";

#define ADC_CH    ADC1_CHANNEL_6     // GPIO34 (from A’s GPIO25)
#define ADC_WIDTH ADC_WIDTH_BIT_12
#define ADC_ATTEN ADC_ATTEN_DB_11
#define VREF_MV   1100
#define SAMPLES   128

esp_adc_cal_characteristics_t adc_chars;
WebSocketsClient ws;

static float readV() {
  uint32_t acc = 0;
  for (int i = 0; i < SAMPLES; ++i) acc += adc1_get_raw(ADC_CH);
  acc /= SAMPLES;
  uint32_t mv = esp_adc_cal_raw_to_voltage(acc, &adc_chars);
  float v = mv / 1000.0f;
  return constrain(v, 0.0f, 3.3f);
}

void setup() {
  Serial.begin(115200);
  WiFi.setSleep(false);                 // improve WS reliability
  WiFi.begin(SSID, PASS);
  while (WiFi.status() != WL_CONNECTED) { delay(250); Serial.print("."); }
  Serial.println("\nWiFi OK");

  adc1_config_width(ADC_WIDTH);
  adc1_config_channel_atten(ADC_CH, ADC_ATTEN);
  esp_adc_cal_characterize(ADC_UNIT_1, ADC_ATTEN, ADC_WIDTH, VREF_MV, &adc_chars);

  ws.begin(WS_HOST, WS_PORT, WS_PATH);
  ws.onEvent([](WStype_t t, uint8_t*, size_t){ /* not required here */ });
}

void loop() {
  ws.loop();
  static uint32_t t=0;
  if (millis() - t >= 200) {
    float v = readV();
    String j = String("{\"received\":") + String(v, 2) + "}";
    ws.sendTXT(j);      // A will rebroadcast to app
    t = millis();
  }
}
